# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Payout logic depends on this (§11)
TZ=Africa/Nairobi

# Local PostgreSQL 18: create the database first:  createdb laibu
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/laibu
DATABASE_SSL=false

# Browser origins allowed to call the API
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://admin.localhost:3000

# 32 random bytes, base64. Generate with:  npm run keys:generate -- --with-data-key
# Losing this key makes stored payout account numbers unreadable. Back it up in the secret store.
DATA_ENCRYPTION_KEY=

# RS256 key pair for sign-in tokens. Generate with:  npm run keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Sprint 2: Redis-compatible queue (Memurai on Windows dev, Redis in production)
REDIS_URL=redis://localhost:6379

BRAND_NAME=Laibu
